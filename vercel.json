{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://xoms-backend-752519899091.asia-south1.run.app/api/v1/:path*"
    },
    { "source": "/listings/:id", "destination": "/listings/[id]" },
    { "source": "/rfq/:listingId", "destination": "/rfq/[listingId]" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
