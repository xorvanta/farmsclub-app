# Set this in Vercel → Project → Settings → Environment Variables.
# Relative path, NOT the absolute Cloud Run URL — vercel.json rewrites /api/v1/* to the backend,
# so requests stay same-origin and the backend never needs a CORS entry for this app.
EXPO_PUBLIC_API_URL=/api/v1
# (Optional — web already defaults to /api/v1 when this is unset; native builds default to the
# absolute Cloud Run URL. See lib/api.ts.)

# Public site origin used for <link rel="canonical"> / og:url. Unset = the browser's own origin.
# EXPO_PUBLIC_SITE_URL=https://farmsclub.in
