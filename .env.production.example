# Set these in Vercel → Project → Settings → Environment Variables.

# Relative path, NOT the absolute Cloud Run URL — vercel.json rewrites /api/v1/public/* to the
# backend, so requests stay same-origin and the backend never needs a CORS entry for this app.
EXPO_PUBLIC_API_URL=/api/v1
# (Optional — web already defaults to /api/v1 when this is unset; native builds default to the
# absolute Cloud Run URL. See lib/api.ts.)

# The backend's own absolute URL — used ONLY for the farm "Chat with the farm" WhatsApp redirect,
# so each visitor's click reaches the backend from their own IP (the click counter de-dupes per
# IP; through the Vercel rewrite every click would share Vercel's IPs). Defaults to Cloud Run.
# EXPO_PUBLIC_API_DIRECT_URL=https://xoms-backend-752519899091.asia-south1.run.app/api/v1

# Public site origin for <link rel="canonical"> / og:url. Defaults to https://farmsclub.in.
# EXPO_PUBLIC_SITE_URL=https://farmsclub.in

# Cloudflare Turnstile site key for the farm registration and "Ask about this farm" forms. When
# set, the widget is shown and its token sent; the backend verifies it when it has the secret.
# Leave unset to rely on the honeypot + minimum fill time only.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
